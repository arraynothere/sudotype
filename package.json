{
  "name": "@arraynothere/sudotype",
  "version": "1.1.0",
  "description": "Zero-config TypeScript toolchain and typed API for any environment.",
  "keywords": [
    "typescript",
    "termux",
    "android",
    "cli",
    "tsx",
    "esbuild",
    "toolchain",
    "scaffold",
    "api"
  ],
  "license": "MIT",
  "author": "Array",
  "homepage": "https://github.com/arraynothere/sudotype#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraynothere/sudotype.git"
  },
  "bugs": {
    "url": "https://github.com/arraynothere/sudotype/issues"
  },
  "bin": {
    "sudotype": "bin/sudotype.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "tsconfig.base.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/smoke.test.js test/api.test.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prepublishOnly": "npm test && npm run test:types"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
